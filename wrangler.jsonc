{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalam-grassroots",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "kalamgrassroots.org", "custom_domain": true },
    { "pattern": "www.kalamgrassroots.org", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
